# Get your free API key at https://build.nvidia.com → top-right "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use (free tier options: meta/llama-3.3-70b-instruct, meta/llama-3.1-8b-instruct)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Database path (use /tmp/lingua.db on Render free tier)
DB_PATH=./lingua.db

# Port (Render sets this automatically)
PORT=8000
